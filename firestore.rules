rules_version = '2';

// Reglas de seguridad de Kody. Cada persona solo puede leer y escribir lo suyo.
// Se publican en Firebase: Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil: apodo y avatar.
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['apodo', 'avatar'])
        && request.resource.data.apodo is string
        && request.resource.data.apodo.size() >= 2
        && request.resource.data.apodo.size() <= 40
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 16;
      allow delete: if false;
    }

    // Proyectos de cada persona.
    match /usuarios/{uid}/proyectos/{id} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre', 'datos', 'actualizado'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 1
        && request.resource.data.nombre.size() <= 60
        && request.resource.data.datos is string
        && request.resource.data.datos.size() <= 900000;
    }

    // Todo lo demás está cerrado.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
